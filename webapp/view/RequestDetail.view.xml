<mvc:View
    controllerName="sapui5.maintenance.controller.RequestDetail"
    displayBlock="true"
    height="100%"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:uxap="sap.uxap"
    xmlns:form="sap.ui.layout.form"
    xmlns="sap.m"
    core:require="{
        formatter: 'sapui5/maintenance/model/formatter',
        Currency: 'sap/ui/model/odata/type/Currency',
        Unit: 'sap/ui/model/odata/type/Unit'
    }">
    <!--
        The controller binds the view to a kept-alive context of the list binding: the properties
        that the list has already read come from its cache, and the model requests only the missing
        ones. Dates and decimals use the OData types that the model derives from the metadata, with
        the format of the locale. Fields without a value are hidden (strings are empty, dates null):
        the visibility expressions read the raw value with %{...} (target type any), so that the
        model does not convert it to the boolean of the visible property.

        The mode of the screen depends only on IsActiveEntity of the bound request: the active request
        (true) is shown in display mode, with "Edit" in the header title; a draft (false) is shown in
        edit mode, with the draft marker and the footer with "Discard". Strict comparisons keep both
        modes hidden while IsActiveEntity is not yet known.
    -->
    <uxap:ObjectPageLayout
        id="requestObjectPage"
        upperCaseAnchorBar="false"
        showFooter="{= %{IsActiveEntity} === false }">
        <!-- Title, number, priority and status: visible in the expanded and in the collapsed header. -->
        <uxap:headerTitle>
            <uxap:ObjectPageDynamicHeaderTitle id="requestHeaderTitle">
                <uxap:heading>
                    <Title id="requestTitle" text="{Title}" level="H2" wrapping="true" />
                </uxap:heading>
                <uxap:expandedContent>
                    <Text id="requestNumberExpanded" text="{RequestID}" />
                </uxap:expandedContent>
                <uxap:snappedContent>
                    <Text id="requestNumberSnapped" text="{RequestID}" />
                </uxap:snappedContent>
                <uxap:content>
                    <ObjectMarker
                        id="requestDraftMarker"
                        type="Draft"
                        visible="{= %{IsActiveEntity} === false }"
                        class="sapUiMediumMarginEnd" />
                    <ObjectStatus
                        id="requestPriority"
                        title="{i18n>headerPriority}"
                        text="{PriorityText}"
                        state="{
                            path: 'PriorityCriticality',
                            targetType: 'any',
                            formatter: 'formatter.criticalityState'
                        }"
                        class="sapUiMediumMarginEnd" />
                    <ObjectStatus
                        id="requestStatus"
                        title="{i18n>headerStatus}"
                        text="{StatusText}"
                        state="{
                            path: 'StatusCriticality',
                            targetType: 'any',
                            formatter: 'formatter.criticalityState'
                        }" />
                </uxap:content>
                <!-- Edit: only for the active request; the action Edit gives the draft of the user. -->
                <uxap:actions>
                    <Button
                        id="editButton"
                        text="{i18n>detailEditButton}"
                        type="Emphasized"
                        visible="{= %{IsActiveEntity} === true }"
                        press=".onEdit" />
                </uxap:actions>
                <!--
                    Full screen, exit full screen and close. Each action is visible when the semantic
                    helper of the column layout gives it a target layout (appView>/actionButtonsInfo).
                -->
                <uxap:navigationActions>
                    <Button
                        id="enterFullScreenButton"
                        type="Transparent"
                        icon="sap-icon://full-screen"
                        tooltip="{i18n>detailEnterFullScreenTooltip}"
                        visible="{= !!${appView>/actionButtonsInfo/midColumn/fullScreen} }"
                        press=".onEnterFullScreen" />
                    <Button
                        id="exitFullScreenButton"
                        type="Transparent"
                        icon="sap-icon://exit-full-screen"
                        tooltip="{i18n>detailExitFullScreenTooltip}"
                        visible="{= !!${appView>/actionButtonsInfo/midColumn/exitFullScreen} }"
                        press=".onExitFullScreen" />
                    <Button
                        id="closeButton"
                        type="Transparent"
                        icon="sap-icon://decline"
                        tooltip="{i18n>detailCloseTooltip}"
                        visible="{= !!${appView>/actionButtonsInfo/midColumn/closeColumn} }"
                        press=".onClose" />
                </uxap:navigationActions>
            </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>
        <!--
            Where the request is and who works on it, and its estimated cost. The cost uses the OData
            Currency type without the code list of the service (customizing part null): the amount
            gets the decimals of its currency and the format of the locale.
        -->
        <uxap:headerContent>
            <FlexBox id="requestHeaderContent" wrap="Wrap" fitContainer="true">
                <VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom">
                    <ObjectAttribute
                        title="{i18n>headerPlant}"
                        text="{PlantName}"
                        visible="{= !!%{PlantName} }" />
                    <ObjectAttribute
                        title="{i18n>headerEquipment}"
                        text="{EquipmentName}"
                        visible="{= !!%{EquipmentName} }" />
                    <ObjectAttribute
                        title="{i18n>headerFunctionalLocation}"
                        text="{FunctionalLocation}"
                        visible="{= !!%{FunctionalLocation} }" />
                </VBox>
                <VBox class="sapUiSmallMarginBottom">
                    <ObjectAttribute
                        title="{i18n>headerAssignedTo}"
                        text="{AssignedTo}"
                        visible="{= !!%{AssignedTo} }" />
                    <ObjectAttribute
                        title="{i18n>headerEstimatedCost}"
                        text="{
                            parts: [
                                { path: 'EstimatedCost' },
                                { path: 'CurrencyCode' },
                                { value: null }
                            ],
                            type: 'Currency'
                        }" />
                </VBox>
            </FlexBox>
        </uxap:headerContent>
        <uxap:sections>
            <!--
                Each section has a single subsection with the same title: the object page shows the
                title of the subsection instead of the title of the section, which the anchor bar uses.
            -->
            <uxap:ObjectPageSection
                id="generalSection"
                title="{i18n>generalSectionTitle}"
                titleUppercase="false">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection id="generalSubSection" title="{i18n>generalSectionTitle}">
                        <uxap:blocks>
                            <form:Form
                                id="generalForm"
                                editable="false"
                                width="auto"
                                class="sapUxAPObjectPageSubSectionAlignContent">
                                <form:layout>
                                    <form:ColumnLayout columnsM="2" columnsL="3" columnsXL="4" />
                                </form:layout>
                                <form:formContainers>
                                    <form:FormContainer id="generalFormContainer">
                                        <form:formElements>
                                            <form:FormElement
                                                label="{i18n>generalRequestType}"
                                                visible="{= !!%{RequestTypeText} }">
                                                <form:fields>
                                                    <Text text="{RequestTypeText}" />
                                                </form:fields>
                                            </form:FormElement>
                                            <form:FormElement
                                                label="{i18n>generalDescription}"
                                                visible="{= !!%{Description} }">
                                                <form:fields>
                                                    <Text text="{Description}" />
                                                </form:fields>
                                            </form:FormElement>
                                            <form:FormElement
                                                label="{i18n>generalReportedBy}"
                                                visible="{= !!%{ReportedBy} }">
                                                <form:fields>
                                                    <Text text="{ReportedBy}" />
                                                </form:fields>
                                            </form:FormElement>
                                            <form:FormElement
                                                label="{i18n>generalRequiredEndDate}"
                                                visible="{= !!%{RequiredEndDate} }">
                                                <form:fields>
                                                    <Text text="{RequiredEndDate}" />
                                                </form:fields>
                                            </form:FormElement>
                                            <form:FormElement
                                                label="{i18n>generalStartedAt}"
                                                visible="{= !!%{StartedAt} }">
                                                <form:fields>
                                                    <Text text="{StartedAt}" />
                                                </form:fields>
                                            </form:FormElement>
                                            <form:FormElement
                                                label="{i18n>generalCompletedAt}"
                                                visible="{= !!%{CompletedAt} }">
                                                <form:fields>
                                                    <Text text="{CompletedAt}" />
                                                </form:fields>
                                            </form:FormElement>
                                            <!--
                                                DowntimeHours is not nullable: it is 0 until the action
                                                complete sets it together with CompletedAt. It has a value
                                                once the work has ended, even if that value is 0.
                                            -->
                                            <form:FormElement
                                                label="{i18n>generalDowntimeHours}"
                                                visible="{= !!%{CompletedAt} }">
                                                <form:fields>
                                                    <Text text="{DowntimeHours}" />
                                                </form:fields>
                                            </form:FormElement>
                                            <form:FormElement
                                                label="{i18n>generalResolution}"
                                                visible="{= !!%{ResolutionText} }">
                                                <form:fields>
                                                    <Text text="{ResolutionText}" />
                                                </form:fields>
                                            </form:FormElement>
                                            <form:FormElement
                                                label="{i18n>generalRejectionReason}"
                                                visible="{= !!%{RejectionReason} }">
                                                <form:fields>
                                                    <Text text="{RejectionReason}" />
                                                </form:fields>
                                            </form:FormElement>
                                        </form:formElements>
                                    </form:FormContainer>
                                </form:formContainers>
                            </form:Form>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
            <!--
                Operations, spare parts and attachments: relative paths to the compositions of the
                request. Each binding reads its collection with an own request ($$ownRequest) on the
                navigation of the shown request, instead of depending on the cache of the list; the
                model derives the $select of that request from the cells.
            -->
            <uxap:ObjectPageSection
                id="tasksSection"
                title="{i18n>tasksSectionTitle}"
                titleUppercase="false">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection id="tasksSubSection" title="{i18n>tasksSectionTitle}">
                        <uxap:blocks>
                            <!-- Sorted by item number; hours are decimals with one decimal place. -->
                            <Table
                                id="taskTable"
                                items="{
                                    path: '_Task',
                                    sorter: { path: 'TaskNumber' },
                                    parameters: { $$ownRequest: true }
                                }"
                                autoPopinMode="true"
                                contextualWidth="Auto"
                                popinLayout="GridSmall"
                                noDataText="{i18n>taskTableNoData}">
                                <columns>
                                    <Column id="taskNumberColumn" width="5rem" importance="High">
                                        <Text text="{i18n>taskColumnNumber}" />
                                    </Column>
                                    <Column id="taskDescriptionColumn" importance="High" autoPopinWidth="10">
                                        <Text text="{i18n>taskColumnDescription}" />
                                    </Column>
                                    <Column id="taskPlannedHoursColumn" width="7rem" hAlign="End" importance="Medium">
                                        <Text text="{i18n>taskColumnPlannedHours}" />
                                    </Column>
                                    <Column id="taskActualHoursColumn" width="7rem" hAlign="End" importance="Medium">
                                        <Text text="{i18n>taskColumnActualHours}" />
                                    </Column>
                                    <Column id="taskCompletedColumn" width="6rem" hAlign="Center" importance="High">
                                        <Text text="{i18n>taskColumnCompleted}" />
                                    </Column>
                                </columns>
                                <items>
                                    <ColumnListItem vAlign="Middle">
                                        <cells>
                                            <Text text="{TaskNumber}" />
                                            <Text text="{Description}" />
                                            <Text text="{PlannedHours}" />
                                            <Text text="{ActualHours}" />
                                            <CheckBox selected="{IsCompleted}" displayOnly="true" />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
            <uxap:ObjectPageSection
                id="partsSection"
                title="{i18n>partsSectionTitle}"
                titleUppercase="false">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection id="partsSubSection" title="{i18n>partsSectionTitle}">
                        <uxap:blocks>
                            <!--
                                Quantity and unit price use the OData Unit and Currency types without the
                                code lists of the service (customizing part null): the format of the locale,
                                and the unit code when the unit is in no list, for example "3 ST". The amount
                                is quantity by unit price, formatted in the currency of the price.
                            -->
                            <Table
                                id="partTable"
                                items="{
                                    path: '_Part',
                                    sorter: { path: 'Product' },
                                    parameters: { $$ownRequest: true }
                                }"
                                autoPopinMode="true"
                                contextualWidth="Auto"
                                popinLayout="GridSmall"
                                noDataText="{i18n>partTableNoData}">
                                <columns>
                                    <Column id="partProductColumn" importance="High" autoPopinWidth="10">
                                        <Text text="{i18n>partColumnProduct}" />
                                    </Column>
                                    <Column id="partQuantityColumn" width="8rem" hAlign="End" importance="High">
                                        <Text text="{i18n>partColumnQuantity}" />
                                    </Column>
                                    <Column id="partUnitPriceColumn" width="8rem" hAlign="End" importance="Medium">
                                        <Text text="{i18n>partColumnUnitPrice}" />
                                    </Column>
                                    <Column id="partAmountColumn" width="8rem" hAlign="End" importance="High">
                                        <Text text="{i18n>partColumnAmount}" />
                                    </Column>
                                </columns>
                                <items>
                                    <ColumnListItem vAlign="Middle">
                                        <cells>
                                            <ObjectIdentifier title="{ProductName}" text="{Product}" />
                                            <Text
                                                text="{
                                                    parts: [
                                                        { path: 'Quantity' },
                                                        { path: 'QuantityUnit' },
                                                        { value: null }
                                                    ],
                                                    type: 'Unit'
                                                }" />
                                            <Text
                                                text="{
                                                    parts: [
                                                        { path: 'UnitPrice' },
                                                        { path: 'CurrencyCode' },
                                                        { value: null }
                                                    ],
                                                    type: 'Currency'
                                                }" />
                                            <Text
                                                text="{
                                                    parts: [
                                                        { path: 'Quantity', targetType: 'any' },
                                                        { path: 'UnitPrice', targetType: 'any' },
                                                        { path: 'CurrencyCode', targetType: 'any' }
                                                    ],
                                                    formatter: 'formatter.partAmount'
                                                }" />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
            <uxap:ObjectPageSection
                id="attachmentsSection"
                title="{i18n>attachmentsSectionTitle}"
                titleUppercase="false">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection id="attachmentsSubSection" title="{i18n>attachmentsSectionTitle}">
                        <uxap:blocks>
                            <!-- File name, comment and media type; the content is not read in this view. -->
                            <List
                                id="attachmentList"
                                items="{
                                    path: '_Attachment',
                                    sorter: { path: 'FileName' },
                                    parameters: { $$ownRequest: true }
                                }"
                                noDataText="{i18n>attachmentListNoData}">
                                <StandardListItem
                                    title="{FileName}"
                                    description="{AttComment}"
                                    info="{MimeType}"
                                    wrapping="true" />
                            </List>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
        </uxap:sections>
        <!-- Footer of the edit mode (showFooter): actions on the draft. -->
        <uxap:footer>
            <OverflowToolbar id="requestFooter">
                <ToolbarSpacer />
                <Button
                    id="discardButton"
                    text="{i18n>detailDiscardButton}"
                    press=".onDiscard" />
            </OverflowToolbar>
        </uxap:footer>
    </uxap:ObjectPageLayout>
</mvc:View>
