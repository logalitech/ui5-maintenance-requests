<mvc:View
    controllerName="sapui5.maintenance.controller.RequestDetail"
    displayBlock="true"
    height="100%"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:uxap="sap.uxap"
    xmlns:form="sap.ui.layout.form"
    xmlns="sap.m"
    core:require="{
        formatter: 'sapui5/maintenance/model/formatter',
        Currency: 'sap/ui/model/odata/type/Currency',
        Unit: 'sap/ui/model/odata/type/Unit'
    }">
    <!--
        The controller binds the view to a kept-alive context of the list binding: the properties
        that the list has already read come from its cache, and the model requests only the missing
        ones. Dates and decimals use the OData types that the model derives from the metadata, with
        the format of the locale. Fields without a value are hidden (strings are empty, dates null):
        the visibility expressions read the raw value with %{...} (target type any), so that the
        model does not convert it to the boolean of the visible property.

        The mode of the screen depends only on IsActiveEntity of the bound request: the active request
        (true) is shown in display mode, with "Edit" in the header title; a draft (false) is shown in
        edit mode, with the draft marker, the input fields of the general information and the footer
        with the messages, "Save" and "Discard". Strict comparisons keep both modes hidden while
        IsActiveEntity is not yet known.
    -->
    <uxap:ObjectPageLayout
        id="requestObjectPage"
        upperCaseAnchorBar="false"
        showFooter="{= %{IsActiveEntity} === false }">
        <!-- Title, number, priority and status: visible in the expanded and in the collapsed header. -->
        <uxap:headerTitle>
            <uxap:ObjectPageDynamicHeaderTitle id="requestHeaderTitle">
                <uxap:heading>
                    <Title id="requestTitle" text="{Title}" level="H2" wrapping="true" />
                </uxap:heading>
                <uxap:expandedContent>
                    <Text id="requestNumberExpanded" text="{RequestID}" />
                </uxap:expandedContent>
                <uxap:snappedContent>
                    <Text id="requestNumberSnapped" text="{RequestID}" />
                </uxap:snappedContent>
                <uxap:content>
                    <ObjectMarker
                        id="requestDraftMarker"
                        type="Draft"
                        visible="{= %{IsActiveEntity} === false }"
                        class="sapUiMediumMarginEnd" />
                    <ObjectStatus
                        id="requestPriority"
                        title="{i18n>headerPriority}"
                        text="{PriorityText}"
                        state="{
                            path: 'PriorityCriticality',
                            targetType: 'any',
                            formatter: 'formatter.criticalityState'
                        }"
                        class="sapUiMediumMarginEnd" />
                    <ObjectStatus
                        id="requestStatus"
                        title="{i18n>headerStatus}"
                        text="{StatusText}"
                        state="{
                            path: 'StatusCriticality',
                            targetType: 'any',
                            formatter: 'formatter.criticalityState'
                        }" />
                </uxap:content>
                <!-- Edit: only for the active request; the action Edit gives the draft of the user. -->
                <uxap:actions>
                    <Button
                        id="editButton"
                        text="{i18n>detailEditButton}"
                        type="Emphasized"
                        visible="{= %{IsActiveEntity} === true }"
                        press=".onEdit" />
                </uxap:actions>
                <!--
                    Full screen, exit full screen and close. Each action is visible when the semantic
                    helper of the column layout gives it a target layout (appView>/actionButtonsInfo).
                -->
                <uxap:navigationActions>
                    <Button
                        id="enterFullScreenButton"
                        type="Transparent"
                        icon="sap-icon://full-screen"
                        tooltip="{i18n>detailEnterFullScreenTooltip}"
                        visible="{= !!${appView>/actionButtonsInfo/midColumn/fullScreen} }"
                        press=".onEnterFullScreen" />
                    <Button
                        id="exitFullScreenButton"
                        type="Transparent"
                        icon="sap-icon://exit-full-screen"
                        tooltip="{i18n>detailExitFullScreenTooltip}"
                        visible="{= !!${appView>/actionButtonsInfo/midColumn/exitFullScreen} }"
                        press=".onExitFullScreen" />
                    <Button
                        id="closeButton"
                        type="Transparent"
                        icon="sap-icon://decline"
                        tooltip="{i18n>detailCloseTooltip}"
                        visible="{= !!${appView>/actionButtonsInfo/midColumn/closeColumn} }"
                        press=".onClose" />
                </uxap:navigationActions>
            </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>
        <!--
            Where the request is and who works on it, and its estimated cost. The cost uses the OData
            Currency type without the code list of the service (customizing part null): the amount
            gets the decimals of its currency and the format of the locale.
        -->
        <uxap:headerContent>
            <FlexBox id="requestHeaderContent" wrap="Wrap" fitContainer="true">
                <VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom">
                    <ObjectAttribute
                        title="{i18n>headerPlant}"
                        text="{PlantName}"
                        visible="{= !!%{PlantName} }" />
                    <ObjectAttribute
                        title="{i18n>headerEquipment}"
                        text="{EquipmentName}"
                        visible="{= !!%{EquipmentName} }" />
                    <ObjectAttribute
                        title="{i18n>headerFunctionalLocation}"
                        text="{FunctionalLocation}"
                        visible="{= !!%{FunctionalLocation} }" />
                </VBox>
                <VBox class="sapUiSmallMarginBottom">
                    <ObjectAttribute
                        title="{i18n>headerAssignedTo}"
                        text="{AssignedTo}"
                        visible="{= !!%{AssignedTo} }" />
                    <ObjectAttribute
                        title="{i18n>headerEstimatedCost}"
                        text="{
                            parts: [
                                { path: 'EstimatedCost' },
                                { path: 'CurrencyCode' },
                                { value: null }
                            ],
                            type: 'Currency'
                        }" />
                </VBox>
            </FlexBox>
        </uxap:headerContent>
        <uxap:sections>
            <!--
                Each section has a single subsection with the same title: the object page shows the
                title of the subsection instead of the title of the section, which the anchor bar uses.
            -->
            <uxap:ObjectPageSection
                id="generalSection"
                title="{i18n>generalSectionTitle}"
                titleUppercase="false">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection id="generalSubSection" title="{i18n>generalSectionTitle}">
                        <uxap:blocks>
                            <!--
                                The modifiable fields (title, type, priority, plant, equipment, description and
                                due date) have a form element of their own for the edit mode, with an input
                                control and required="true" for the mandatory fields of the service. The form
                                elements of the display mode show the same data as text. The other fields are set
                                by the service and are shown as text in both modes.

                                Each input control is bound two-way to its property of the draft: a change is sent
                                to the service as a PATCH request in the group $auto, without a button. The model
                                derives the type of each binding from the metadata (length of the strings, Edm.Date
                                for the due date). The messages of the service bound to a property (a failed
                                validation of the activation) and the parse errors of the types mark the field.

                                The code lists are suspended, so that the display mode does not read them; the
                                controller resumes them the first time a draft is shown. The equipment list holds
                                the equipments of the plant of the draft (filtered by the controller). The value of
                                the equipment field is the name of the equipment of the request (one-way): it is
                                shown also when the equipment is not in the list of the plant.
                            -->
                            <form:Form
                                id="generalForm"
                                editable="{= %{IsActiveEntity} === false }"
                                width="auto"
                                class="sapUxAPObjectPageSubSectionAlignContent">
                                <form:layout>
                                    <form:ColumnLayout columnsM="2" columnsL="3" columnsXL="4" />
                                </form:layout>
                                <form:formContainers>
                                    <form:FormContainer id="generalFormContainer">
                                        <form:formElements>
                                            <form:FormElement
                                                label="{i18n>generalTitle}"
                                                visible="{= %{IsActiveEntity} === false }">
                                                <form:fields>
                                                    <Input id="titleInput" value="{Title}" required="true" />
                                                </form:fields>
                                            </form:FormElement>
                                            <form:FormElement
                                                label="{i18n>generalRequestType}"
                                                visible="{= %{IsActiveEntity} === true &amp;&amp; !!%{RequestTypeText} }">
                                                <form:fields>
                                                    <Text text="{RequestTypeText}" />
                                                </form:fields>
                                            </form:FormElement>
                                            <form:FormElement
                                                label="{i18n>generalRequestType}"
                                                visible="{= %{IsActiveEntity} === false }">
                                                <form:fields>
                                                    <Select
                                                        id="requestTypeSelect"
                                                        selectedKey="{RequestType}"
                                                        forceSelection="false"
                                                        required="true"
                                                        width="100%"
                                                        items="{
                                                            path: '/RequestTypes',
                                                            sorter: { path: 'SortOrder' },
                                                            suspended: true
                                                        }">
                                                        <core:Item key="{RequestType}" text="{RequestTypeText}" />
                                                    </Select>
                                                </form:fields>
                                            </form:FormElement>
                                            <form:FormElement
                                                label="{i18n>generalPriority}"
                                                visible="{= %{IsActiveEntity} === false }">
                                                <form:fields>
                                                    <Select
                                                        id="prioritySelect"
                                                        selectedKey="{Priority}"
                                                        forceSelection="false"
                                                        required="true"
                                                        width="100%"
                                                        items="{
                                                            path: '/Priorities',
                                                            sorter: { path: 'SortOrder' },
                                                            suspended: true
                                                        }">
                                                        <core:Item key="{Priority}" text="{PriorityText}" />
                                                    </Select>
                                                </form:fields>
                                            </form:FormElement>
                                            <form:FormElement
                                                label="{i18n>generalPlant}"
                                                visible="{= %{IsActiveEntity} === false }">
                                                <form:fields>
                                                    <ComboBox
                                                        id="plantComboBox"
                                                        selectedKey="{Plant}"
                                                        required="true"
                                                        showSecondaryValues="true"
                                                        items="{
                                                            path: '/Plants',
                                                            sorter: { path: 'PlantName' },
                                                            suspended: true
                                                        }"
                                                        change=".onPlantChange">
                                                        <core:ListItem key="{Plant}" text="{PlantName}" additionalText="{Plant}" />
                                                    </ComboBox>
                                                </form:fields>
                                            </form:FormElement>
                                            <form:FormElement
                                                label="{i18n>generalEquipment}"
                                                visible="{= %{IsActiveEntity} === false }">
                                                <form:fields>
                                                    <ComboBox
                                                        id="equipmentComboBox"
                                                        selectedKey="{Equipment}"
                                                        value="{ path: 'EquipmentName', mode: 'OneWay' }"
                                                        required="true"
                                                        showSecondaryValues="true"
                                                        items="{
                                                            path: '/Equipments',
                                                            sorter: { path: 'EquipmentName' },
                                                            suspended: true
                                                        }">
                                                        <core:ListItem
                                                            key="{Equipment}"
                                                            text="{EquipmentName}"
                                                            additionalText="{Equipment}" />
                                                    </ComboBox>
                                                </form:fields>
                                            </form:FormElement>
                                            <form:FormElement
                                                label="{i18n>generalDescription}"
                                                visible="{= %{IsActiveEntity} === true &amp;&amp; !!%{Description} }">
                                                <form:fields>
                                                    <Text text="{Description}" />
                                                </form:fields>
                                            </form:FormElement>
                                            <form:FormElement
                                                label="{i18n>generalDescription}"
                                                visible="{= %{IsActiveEntity} === false }">
                                                <form:fields>
                                                    <TextArea
                                                        id="descriptionTextArea"
                                                        value="{Description}"
                                                        rows="4"
                                                        growing="true"
                                                        growingMaxLines="10"
                                                        width="100%" />
                                                </form:fields>
                                            </form:FormElement>
                                            <form:FormElement
                                                label="{i18n>generalReportedBy}"
                                                visible="{= !!%{ReportedBy} }">
                                                <form:fields>
                                                    <Text text="{ReportedBy}" />
                                                </form:fields>
                                            </form:FormElement>
                                            <form:FormElement
                                                label="{i18n>generalRequiredEndDate}"
                                                visible="{= %{IsActiveEntity} === true &amp;&amp; !!%{RequiredEndDate} }">
                                                <form:fields>
                                                    <Text text="{RequiredEndDate}" />
                                                </form:fields>
                                            </form:FormElement>
                                            <form:FormElement
                                                label="{i18n>generalRequiredEndDate}"
                                                visible="{= %{IsActiveEntity} === false }">
                                                <form:fields>
                                                    <DatePicker id="requiredEndDatePicker" value="{RequiredEndDate}" />
                                                </form:fields>
                                            </form:FormElement>
                                            <form:FormElement
                                                label="{i18n>generalStartedAt}"
                                                visible="{= !!%{StartedAt} }">
                                                <form:fields>
                                                    <Text text="{StartedAt}" />
                                                </form:fields>
                                            </form:FormElement>
                                            <form:FormElement
                                                label="{i18n>generalCompletedAt}"
                                                visible="{= !!%{CompletedAt} }">
                                                <form:fields>
                                                    <Text text="{CompletedAt}" />
                                                </form:fields>
                                            </form:FormElement>
                                            <!--
                                                DowntimeHours is not nullable: it is 0 until the action
                                                complete sets it together with CompletedAt. It has a value
                                                once the work has ended, even if that value is 0.
                                            -->
                                            <form:FormElement
                                                label="{i18n>generalDowntimeHours}"
                                                visible="{= !!%{CompletedAt} }">
                                                <form:fields>
                                                    <Text text="{DowntimeHours}" />
                                                </form:fields>
                                            </form:FormElement>
                                            <form:FormElement
                                                label="{i18n>generalResolution}"
                                                visible="{= !!%{ResolutionText} }">
                                                <form:fields>
                                                    <Text text="{ResolutionText}" />
                                                </form:fields>
                                            </form:FormElement>
                                            <form:FormElement
                                                label="{i18n>generalRejectionReason}"
                                                visible="{= !!%{RejectionReason} }">
                                                <form:fields>
                                                    <Text text="{RejectionReason}" />
                                                </form:fields>
                                            </form:FormElement>
                                        </form:formElements>
                                    </form:FormContainer>
                                </form:formContainers>
                            </form:Form>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
            <!--
                Operations, spare parts and attachments: relative paths to the compositions of the
                request. Each binding reads its collection with an own request ($$ownRequest) on the
                navigation of the shown request, instead of depending on the cache of the list; the
                model derives the $select of that request from the cells.

                In edit mode the operations and the spare parts of the draft can be changed. The toolbar
                of the table adds an item: "Add" is enabled by the dynamic control of the service
                (__CreateByAssociationControl). The delete icon of a row (mode Delete) deletes the item.
                Each cell of a row holds a text and an input field: the text when the item is active
                (IsActiveEntity true), the input field otherwise, also for a new item while the service
                creates it (its IsActiveEntity is not known yet). The input fields are bound two-way to
                the item, so each change is sent to the draft like the fields of the request, and they
                are labelled by the header of their column. The cells with a wrapper set the alignment
                of the column on their controls, because the table only applies it to the cell itself.
            -->
            <uxap:ObjectPageSection
                id="tasksSection"
                title="{i18n>tasksSectionTitle}"
                titleUppercase="false">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection id="tasksSubSection" title="{i18n>tasksSectionTitle}">
                        <uxap:blocks>
                            <!-- Sorted by item number; hours are decimals with one decimal place. -->
                            <Table
                                id="taskTable"
                                items="{
                                    path: '_Task',
                                    sorter: { path: 'TaskNumber' },
                                    parameters: { $$ownRequest: true }
                                }"
                                mode="{= %{IsActiveEntity} === false ? 'Delete' : 'None' }"
                                autoPopinMode="true"
                                contextualWidth="Auto"
                                popinLayout="GridSmall"
                                noDataText="{i18n>taskTableNoData}"
                                delete=".onDeleteItem">
                                <headerToolbar>
                                    <OverflowToolbar id="taskToolbar" visible="{= %{IsActiveEntity} === false }">
                                        <ToolbarSpacer />
                                        <Button
                                            id="addTaskButton"
                                            text="{i18n>taskAddButton}"
                                            enabled="{= %{__CreateByAssociationControl/_Task} === true }"
                                            press=".onAddTask" />
                                    </OverflowToolbar>
                                </headerToolbar>
                                <columns>
                                    <Column id="taskNumberColumn" width="5rem" importance="High">
                                        <Text id="taskNumberHeader" text="{i18n>taskColumnNumber}" />
                                    </Column>
                                    <Column id="taskDescriptionColumn" importance="High" autoPopinWidth="10">
                                        <Text id="taskDescriptionHeader" text="{i18n>taskColumnDescription}" />
                                    </Column>
                                    <Column id="taskPlannedHoursColumn" width="7rem" hAlign="End" importance="Medium">
                                        <Text id="taskPlannedHoursHeader" text="{i18n>taskColumnPlannedHours}" />
                                    </Column>
                                    <Column id="taskActualHoursColumn" width="7rem" hAlign="End" importance="Medium">
                                        <Text id="taskActualHoursHeader" text="{i18n>taskColumnActualHours}" />
                                    </Column>
                                    <Column id="taskCompletedColumn" width="6rem" hAlign="Center" importance="High">
                                        <Text id="taskCompletedHeader" text="{i18n>taskColumnCompleted}" />
                                    </Column>
                                </columns>
                                <items>
                                    <ColumnListItem vAlign="Middle">
                                        <cells>
                                            <VBox renderType="Bare">
                                                <Text text="{TaskNumber}" visible="{= %{IsActiveEntity} === true }" />
                                                <Input
                                                    value="{TaskNumber}"
                                                    ariaLabelledBy="taskNumberHeader"
                                                    visible="{= %{IsActiveEntity} !== true }" />
                                            </VBox>
                                            <VBox renderType="Bare">
                                                <Text text="{Description}" visible="{= %{IsActiveEntity} === true }" />
                                                <Input
                                                    value="{Description}"
                                                    ariaLabelledBy="taskDescriptionHeader"
                                                    visible="{= %{IsActiveEntity} !== true }" />
                                            </VBox>
                                            <VBox renderType="Bare">
                                                <Text
                                                    text="{PlannedHours}"
                                                    textAlign="End"
                                                    visible="{= %{IsActiveEntity} === true }" />
                                                <Input
                                                    value="{PlannedHours}"
                                                    textAlign="End"
                                                    ariaLabelledBy="taskPlannedHoursHeader"
                                                    visible="{= %{IsActiveEntity} !== true }" />
                                            </VBox>
                                            <VBox renderType="Bare">
                                                <Text
                                                    text="{ActualHours}"
                                                    textAlign="End"
                                                    visible="{= %{IsActiveEntity} === true }" />
                                                <Input
                                                    value="{ActualHours}"
                                                    textAlign="End"
                                                    ariaLabelledBy="taskActualHoursHeader"
                                                    visible="{= %{IsActiveEntity} !== true }" />
                                            </VBox>
                                            <CheckBox
                                                selected="{IsCompleted}"
                                                displayOnly="{= %{IsActiveEntity} === true }"
                                                ariaLabelledBy="taskCompletedHeader" />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
            <uxap:ObjectPageSection
                id="partsSection"
                title="{i18n>partsSectionTitle}"
                titleUppercase="false">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection id="partsSubSection" title="{i18n>partsSectionTitle}">
                        <uxap:blocks>
                            <!--
                                Quantity and unit price use the OData Unit and Currency types without the
                                code lists of the service (customizing part null): the format of the locale,
                                and the unit code when the unit is in no list, for example "3 ST". The amount
                                is quantity by unit price, formatted in the currency of the price.

                                In edit mode the material is entered by its code, with the name that the
                                service sets as description; quantity and unit price are entered as decimals
                                (type from the metadata), with the unit and the currency as description. A
                                change of the quantity or of the unit price, and the creation or deletion of a
                                spare part, change the estimated cost of the header (side effects, loaded by
                                the controller).
                            -->
                            <Table
                                id="partTable"
                                items="{
                                    path: '_Part',
                                    sorter: { path: 'Product' },
                                    parameters: { $$ownRequest: true }
                                }"
                                mode="{= %{IsActiveEntity} === false ? 'Delete' : 'None' }"
                                autoPopinMode="true"
                                contextualWidth="Auto"
                                popinLayout="GridSmall"
                                noDataText="{i18n>partTableNoData}"
                                delete=".onDeleteItem">
                                <headerToolbar>
                                    <OverflowToolbar id="partToolbar" visible="{= %{IsActiveEntity} === false }">
                                        <ToolbarSpacer />
                                        <Button
                                            id="addPartButton"
                                            text="{i18n>partAddButton}"
                                            enabled="{= %{__CreateByAssociationControl/_Part} === true }"
                                            press=".onAddPart" />
                                    </OverflowToolbar>
                                </headerToolbar>
                                <columns>
                                    <Column id="partProductColumn" importance="High" autoPopinWidth="10">
                                        <Text id="partProductHeader" text="{i18n>partColumnProduct}" />
                                    </Column>
                                    <Column id="partQuantityColumn" width="10rem" hAlign="End" importance="High">
                                        <Text id="partQuantityHeader" text="{i18n>partColumnQuantity}" />
                                    </Column>
                                    <Column id="partUnitPriceColumn" width="10rem" hAlign="End" importance="Medium">
                                        <Text id="partUnitPriceHeader" text="{i18n>partColumnUnitPrice}" />
                                    </Column>
                                    <Column id="partAmountColumn" width="8rem" hAlign="End" importance="High">
                                        <Text text="{i18n>partColumnAmount}" />
                                    </Column>
                                </columns>
                                <items>
                                    <ColumnListItem vAlign="Middle">
                                        <cells>
                                            <VBox renderType="Bare">
                                                <ObjectIdentifier
                                                    title="{ProductName}"
                                                    text="{Product}"
                                                    visible="{= %{IsActiveEntity} === true }" />
                                                <Input
                                                    value="{Product}"
                                                    description="{ProductName}"
                                                    fieldWidth="40%"
                                                    ariaLabelledBy="partProductHeader"
                                                    visible="{= %{IsActiveEntity} !== true }" />
                                            </VBox>
                                            <VBox renderType="Bare">
                                                <Text
                                                    text="{
                                                        parts: [
                                                            { path: 'Quantity' },
                                                            { path: 'QuantityUnit' },
                                                            { value: null }
                                                        ],
                                                        type: 'Unit'
                                                    }"
                                                    textAlign="End"
                                                    visible="{= %{IsActiveEntity} === true }" />
                                                <Input
                                                    value="{Quantity}"
                                                    description="{QuantityUnit}"
                                                    fieldWidth="70%"
                                                    textAlign="End"
                                                    ariaLabelledBy="partQuantityHeader"
                                                    visible="{= %{IsActiveEntity} !== true }" />
                                            </VBox>
                                            <VBox renderType="Bare">
                                                <Text
                                                    text="{
                                                        parts: [
                                                            { path: 'UnitPrice' },
                                                            { path: 'CurrencyCode' },
                                                            { value: null }
                                                        ],
                                                        type: 'Currency'
                                                    }"
                                                    textAlign="End"
                                                    visible="{= %{IsActiveEntity} === true }" />
                                                <Input
                                                    value="{UnitPrice}"
                                                    description="{CurrencyCode}"
                                                    fieldWidth="70%"
                                                    textAlign="End"
                                                    ariaLabelledBy="partUnitPriceHeader"
                                                    visible="{= %{IsActiveEntity} !== true }" />
                                            </VBox>
                                            <Text
                                                text="{
                                                    parts: [
                                                        { path: 'Quantity', targetType: 'any' },
                                                        { path: 'UnitPrice', targetType: 'any' },
                                                        { path: 'CurrencyCode', targetType: 'any' }
                                                    ],
                                                    formatter: 'formatter.partAmount'
                                                }" />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
            <uxap:ObjectPageSection
                id="attachmentsSection"
                title="{i18n>attachmentsSectionTitle}"
                titleUppercase="false">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection id="attachmentsSubSection" title="{i18n>attachmentsSectionTitle}">
                        <uxap:blocks>
                            <!-- File name, comment and media type; the content is not read in this view. -->
                            <List
                                id="attachmentList"
                                items="{
                                    path: '_Attachment',
                                    sorter: { path: 'FileName' },
                                    parameters: { $$ownRequest: true }
                                }"
                                noDataText="{i18n>attachmentListNoData}">
                                <StandardListItem
                                    title="{FileName}"
                                    description="{AttComment}"
                                    info="{MimeType}"
                                    wrapping="true" />
                            </List>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
        </uxap:sections>
        <!--
            Footer of the edit mode (showFooter). On the left, the message button: visible while the message
            model (message>/, see sap.ui.core.Messaging) holds messages, with their number, and the color and
            icon of the most severe one; it opens the message popover with their detail. On the right, the
            saving state of the draft (detailView>/draftState: "Saving draft..." and "Draft saved") and the
            actions on the draft: "Save" activates it, "Discard" discards it.
        -->
        <uxap:footer>
            <OverflowToolbar id="requestFooter">
                <Button
                    id="messagesButton"
                    type="{ path: 'message>/', formatter: 'formatter.messagesButtonType' }"
                    icon="{ path: 'message>/', formatter: 'formatter.messagesButtonIcon' }"
                    text="{= ${message>/}.length }"
                    tooltip="{i18n>messagesButtonTooltip}"
                    ariaHasPopup="Dialog"
                    visible="{= ${message>/}.length > 0 }"
                    press=".onOpenMessages" />
                <ToolbarSpacer />
                <Text
                    id="draftStateText"
                    text="{
                        parts: [
                            { path: 'detailView>/draftState' },
                            { path: 'i18n>draftSavingText' },
                            { path: 'i18n>draftSavedText' }
                        ],
                        formatter: 'formatter.draftStateText'
                    }" />
                <Button
                    id="saveButton"
                    text="{i18n>detailSaveButton}"
                    type="Emphasized"
                    press=".onSave" />
                <Button
                    id="discardButton"
                    text="{i18n>detailDiscardButton}"
                    press=".onDiscard" />
            </OverflowToolbar>
        </uxap:footer>
    </uxap:ObjectPageLayout>
</mvc:View>
