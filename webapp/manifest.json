{
  "_version": "2.0.0",
  "sap.app": {
    "id": "sapui5.maintenance",
    "type": "application",
    "i18n": {
      "bundleName": "sapui5.maintenance.i18n.i18n",
      "supportedLocales": [
        "",
        "es"
      ],
      "fallbackLocale": ""
    },
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.33.0",
      "toolsId": "8f811f73-9236-4ce4-bf26-a0f1aabcd919"
    },
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_mnt_request_o4/srvd/sap/zui_mnt_request/0001/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0",
          "localUri": "localService/mainService/metadata.xml"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.148.0",
      "libs": {
        "sap.m": {},
        "sap.f": {},
        "sap.uxap": {},
        "sap.ui.core": {},
        "sap.ui.layout": {},
        "sap.ui.unified": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "sapui5.maintenance.i18n.i18n",
          "supportedLocales": [
            "",
            "es"
          ],
          "fallbackLocale": ""
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true,
          "groupId": "$auto"
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.f.routing.Router",
        "controlId": "fcl",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "sapui5.maintenance.view"
      },
      "routes": [
        {
          "name": "list",
          "pattern": ":?query:",
          "target": [
            "list"
          ]
        },
        {
          "name": "detail",
          "pattern": "detail/{uuid}/{active}/:layout:",
          "target": [
            "list",
            "detail"
          ]
        }
      ],
      "targets": {
        "list": {
          "name": "RequestList",
          "id": "requestList",
          "controlAggregation": "beginColumnPages"
        },
        "detail": {
          "name": "RequestDetail",
          "id": "requestDetail",
          "controlAggregation": "midColumnPages"
        },
        "notFound": {
          "name": "NotFound",
          "id": "notFound",
          "controlAggregation": "midColumnPages"
        }
      }
    },
    "rootView": {
      "viewName": "sapui5.maintenance.view.App",
      "type": "XML",
      "id": "App"
    }
  }
}
